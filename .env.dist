COLLECTOR_REDIS_ENABLED=true
COLLECTOR_REDIS_HOST=localhost
COLLECTOR_REDIS_TLS_ENABLED=false
COLLECTOR_REDIS_PORT=6379
COLLECTOR_REDIS_USERNAME=dev
COLLECTOR_REDIS_PASSWORD=dev
COLLECTOR_REDIS_PERIODICITY_SECONDS=60

COLLECTOR_MONGODB_ENABLED=true
COLLECTOR_MONGODB_URL=mongodb://localhost:27017
COLLECTOR_MONGODB_USERNAME=dev
COLLECTOR_MONGODB_PASSWORD=dev
COLLECTOR_MONGODB_AUTH_SOURCE=admin
COLLECTOR_MONGODB_PERIODICITY_SECONDS=60

EXPORTER_OTEL_ENABLED=true
EXPORTER_OTEL_PERIODICITY_SECONDS=30
EXPORTER_OTEL_ENDPOINT=http://localhost:4318/v1/metrics
EXPORTER_OTEL_HEADERS=Authorization: Bearer dev

EXPORTER_OTEL_ENABLED=true
EXPORTER_OTEL_PERIODICITY_SECONDS=30
EXPORTER_OTEL_ENDPOINT=http://localhost:4318/v1/metrics
SERVICE_NAME=Metricestan

EXPORTER_NEW_RELIC_ENABLED=true
EXPORTER_NEW_RELIC_ENDPOINT=https://metric-api.newrelic.com/metric/v1 
EXPORTER_NEW_RELIC_LICENSE_KEY=dev
EXPORTER_NEW_RELIC_APP_NAME=Metricestan
EXPORTER_NEW_RELIC_PERIODICITY_SECONDS=30